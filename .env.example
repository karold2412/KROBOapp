# KROBO system configuration. Do not fill in the keys by hand: run
#   python3 scripts/init-env.py
# which creates .env with generated passwords and keys.
# The same .env must be present on each of the three laptops (copy it by hand, not via
# Syncthing): without GMAIL_TOKEN_KEY a replica cannot send mail after taking over.

# Public hostname (without https://), e.g. app.yourdomain.pl
PUBLIC_DOMAIN=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Set to false only for testing through http://localhost:8080 (e.g. the language switch)
DJANGO_COOKIE_SECURE=true

# Database
POSTGRES_DB=krobo
POSTGRES_USER=krobo
POSTGRES_PASSWORD=

# Cloudflare tunnel: token from the Cloudflare dashboard (Networking -> Tunnels), docs/stage-0.md step 4
CLOUDFLARE_TUNNEL_TOKEN=

# Gmail accounts named in the company <-> contractor agreement
GMAIL_COMPANY_ADDRESS=
GMAIL_COMPANY_NAME="KROBO sp. z o.o."
GMAIL_CONTRACTOR_ADDRESS=
GMAIL_CONTRACTOR_NAME="KROBO Karol Duda"
# Key that encrypts the Gmail tokens stored in the database
GMAIL_TOKEN_KEY=
