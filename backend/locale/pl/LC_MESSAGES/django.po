#, python-format
msgid "[KROBO] Delivery test, stage 0, %(time)s"
msgstr "[KROBO] Test wysyłki, etap 0, %(time)s"

#: mailer/management/commands/gmail_send_test.py:21
#, python-format
msgid ""
"This is a test message from the KROBO system (stage 0).\n"
"\n"
"Sender: %(sender)s\n"
"Recipient: %(recipient)s\n"
"Sent at: %(time)s (Europe/Warsaw)\n"
"\n"
"This message confirms that the server sends mail through the Gmail API. No reply is needed.\n"
msgstr ""
"To jest wiadomość testowa systemu KROBO (etap 0).\n"
"\n"
"Nadawca: %(sender)s\n"
"Odbiorca: %(recipient)s\n"
"Czas wysłania: %(time)s (Europe/Warsaw)\n"
"\n"
"Wiadomość potwierdza, że serwer wysyła maile przez Gmail API. Nie wymaga odpowiedzi.\n"

